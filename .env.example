# Production data platform. Keep real values only in the root .env.
DATABASE_URL=postgresql://ai_trip:ai_trip@localhost:5432/ai_trip
REDIS_URL=redis://localhost:6379
ROCKETMQ_ENDPOINT=localhost:8081
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=
ROCKETMQ_TOPIC_PLANNING=ai-trip-planning
MILVUS_ADDRESS=localhost:19530
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=ai_trip
EMBEDDING_PROVIDER=bailian
EMBEDDING_MODEL=text-embedding-v4

# Route cards and planning jobs are stored in PostgreSQL.

# Real map provider. Required for real POI candidates and walking estimates.
AMAP_WEB_SERVICE_KEY=

NEXT_PUBLIC_AMAP_JS_API_KEY=你的JSAPI key
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=你的JSAPI安全密钥
# Route AI provider. Use "openai", "deepseek", or "bailian"; unset defaults to "openai".
AI_PROVIDER=openai

# OpenAI Responses API provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# DeepSeek Chat Completions provider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Alibaba Cloud Bailian Model Studio OpenAI-compatible provider.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus

# Public web evidence provider. Keep the real key only in the root .env.
SEARCH_PROVIDER=exa
EXA_API_KEY=your-exa-api-key
